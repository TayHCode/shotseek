{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "tool": {
      "type": "string",
      "enum": [
        "shotseek"
      ]
    },
    "tool_version": {
      "type": "string"
    },
    "command": {
      "type": "string",
      "enum": [
        "transcribe"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "aroll",
            "transcript",
            "points",
            "beats"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration": {
          "type": [
            "number",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "whisper_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcript_cached": {
          "type": "boolean"
        },
        "size": {
          "type": "integer"
        },
        "content_sample": {
          "type": "string"
        },
        "excluded_file_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "path",
        "duration",
        "language",
        "whisper_model",
        "transcript_cached"
      ],
      "additionalProperties": false
    },
    "transcript": {
      "type": "object",
      "properties": {
        "timed": {
          "type": "boolean"
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "start": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "end": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "start",
              "end",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "timed",
        "segments"
      ],
      "additionalProperties": false
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": [
              "number",
              "null"
            ]
          },
          "end": {
            "type": [
              "number",
              "null"
            ]
          },
          "timecode": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          },
          "segment_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "queries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "sentence",
                    "keywords",
                    "point",
                    "agent",
                    "topic"
                  ]
                }
              },
              "required": [
                "text",
                "source"
              ],
              "additionalProperties": false
            }
          },
          "skipped": {
            "type": "boolean"
          },
          "skip_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "need_score": {
            "type": "number"
          },
          "need_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "topic": {
            "type": [
              "string",
              "null"
            ]
          },
          "suggested_broll": {
            "type": "string"
          },
          "search_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "placement": {
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "end": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        },
        "required": [
          "id",
          "start",
          "end",
          "timecode",
          "text",
          "segment_ids",
          "keywords",
          "queries",
          "skipped",
          "skip_reason",
          "need_score",
          "need_reasons",
          "topic",
          "suggested_broll",
          "search_terms",
          "placement"
        ],
        "additionalProperties": false
      }
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        }
      },
      "required": [
        "code",
        "message",
        "hint",
        "exit_code"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "tool",
    "tool_version",
    "command",
    "ok",
    "warnings",
    "source",
    "transcript",
    "beats"
  ],
  "additionalProperties": false
}
