{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "tool": {
      "type": "string",
      "enum": [
        "shotseek"
      ]
    },
    "tool_version": {
      "type": "string"
    },
    "command": {
      "type": "string",
      "enum": [
        "init"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "config_path": {
      "type": "string"
    },
    "index_dir": {
      "type": "string"
    },
    "libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "display_root": {
            "type": "string"
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reachable": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "root",
          "display_root",
          "exclude",
          "reachable"
        ],
        "additionalProperties": false
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        }
      },
      "required": [
        "code",
        "message",
        "hint",
        "exit_code"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "tool",
    "tool_version",
    "command",
    "ok",
    "warnings",
    "config_path",
    "index_dir",
    "libraries",
    "next_steps"
  ],
  "additionalProperties": false
}
