{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "tool": {
      "type": "string",
      "enum": [
        "shotseek"
      ]
    },
    "tool_version": {
      "type": "string"
    },
    "command": {
      "type": "string",
      "enum": [
        "index"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "interrupted",
        "aborted"
      ]
    },
    "stop_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "device": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number"
    },
    "libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "reachable": {
            "type": "boolean"
          },
          "walk_complete": {
            "type": "boolean"
          },
          "discovered": {
            "type": "integer"
          },
          "new": {
            "type": "integer"
          },
          "changed": {
            "type": "integer"
          },
          "unchanged": {
            "type": "integer"
          },
          "indexed": {
            "type": "integer"
          },
          "failed": {
            "type": "integer"
          },
          "unsupported": {
            "type": "integer"
          },
          "removed": {
            "type": "integer"
          },
          "prune_deferred": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "root",
          "reachable",
          "walk_complete",
          "discovered",
          "new",
          "changed",
          "unchanged",
          "indexed",
          "failed",
          "unsupported",
          "removed",
          "prune_deferred"
        ],
        "additionalProperties": false
      }
    },
    "totals": {
      "type": "object",
      "properties": {
        "files_indexed": {
          "type": "integer"
        },
        "vectors_added": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "removed": {
          "type": "integer"
        }
      },
      "required": [
        "files_indexed",
        "vectors_added",
        "failed",
        "removed"
      ],
      "additionalProperties": false
    },
    "failures_sample": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "library": {
            "type": "string"
          },
          "relative_path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "library",
          "relative_path",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "index": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string"
        },
        "files": {
          "type": "integer"
        },
        "vectors": {
          "type": "integer"
        },
        "searchable": {
          "type": "boolean"
        }
      },
      "required": [
        "dir",
        "files",
        "vectors",
        "searchable"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        }
      },
      "required": [
        "code",
        "message",
        "hint",
        "exit_code"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "tool",
    "tool_version",
    "command",
    "ok",
    "warnings",
    "status",
    "stop_reason",
    "device",
    "model",
    "duration_seconds",
    "libraries",
    "totals",
    "failures_sample",
    "index"
  ],
  "additionalProperties": false
}
